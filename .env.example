# Copy to .env.local and fill in from your Supabase project (Settings → API).
# While these are empty, the site runs on the bundled demo data in src/data/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed only for affiliate network webhooks (not used yet).
# Never prefix with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for metadata, email confirmation links and (later) referral links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
