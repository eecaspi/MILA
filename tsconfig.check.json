{
  "//": "Typechecks the framework-free layer (config, domain types, data, scripts). Usable without installing dependencies.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [],
    "incremental": false,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/config/**/*.ts",
    "src/lib/types.ts",
    "src/lib/format.ts",
    "src/lib/data/mappers*.ts",
    "src/lib/analytics/parse*.ts",
    "src/lib/admin/validate*.ts",
    "src/data/**/*.ts",
    "src/lib/rewards/types.ts",
    "src/lib/rewards/format.ts",
    "src/lib/rewards/conversions.ts",
    "src/lib/rewards/*.test.ts",
    "src/lib/notifications/**/*.ts",
    "src/lib/auth/messages.ts",
    "scripts/**/*.ts"
  ]
}
